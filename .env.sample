# Amelia Voice – copy to .env and fill in values
# Required for chat and voice

OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Optional: use GOOGLE_PROJECT as alias for GOOGLE_CLOUD_PROJECT
# GOOGLE_PROJECT=

# --- STT ---
# google (default) or whisper (OpenAI; good for Japanese)
# STT_PROVIDER=google
# true (default) = streaming STT (WebSocket); false = batch POST /api/transcribe
# STT_STREAMING=true

# --- Chat backend ---
# greig = OpenAI with tools; fred = RAG (process_query); passthru = proxy to CHAT_PASSTHRU_URL
# CHAT_BACKEND=greig
# When CHAT_BACKEND=passthru, URL to call (expects query + history, returns answer/sources/intent)
# CHAT_PASSTHRU_URL=http://localhost:8000/api/chat

# --- Voice prompt ---
# brief | normal (default) | detailed
# VOICE_VERBOSITY=normal
# Optional full system prompt; placeholders: {language_instruction} {verbosity_instruction}
# VOICE_PROMPT_TEMPLATE=

# --- Web search (Tavily) ---
# When set, chat can use web_search tool
# TAVILY_API_KEY=

# --- Twilio (Phase 3) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Public base URL (e.g. https://xxx.ngrok.io) for voice webhook
# TWILIO_VOICE_WEBHOOK_URL=
# TWILIO_AI=openai
# TWILIO_LANGUAGE=ja
# Set to 1/true to skip signature validation (dev only)
# TWILIO_SKIP_VALIDATION=

# --- Azure Search (optional; for fred RAG hybrid_search) ---
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_INDEX=
# AZURE_SEARCH_KEY=
# OPENAI_EMBED_DEPLOYMENT=
# AZURE_SEARCH_SEMANTIC_CONFIG=my-semantic-config

# --- Web UI auth (set AUTH_JWT_SECRET to protect /api/* except login/logout) ---
# AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Path to JSON user map (see auth_users.example.json); never commit real auth_users.json
# AUTH_USERS_FILE=./auth_users.json
# Optional: cookie Secure flag behind HTTPS (default false)
# AUTH_COOKIE_SECURE=false
# Session length: default 48h. AUTH_JWT_EXPIRE_DAYS overrides if set (whole days).
# AUTH_JWT_EXPIRE_HOURS=48
# AUTH_JWT_EXPIRE_DAYS=

# --- Web UI ---
# When true, end users do not see the settings sidebar (still exposed via GET /api/auth/me as hide_sidebar).
# HIDE_SIDEBAR=false
